generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  role            Role     @default(ALUMNA)
  nombre          String?
  apellido        String?
  cedula          String?
  fechaNacimiento DateTime?
  edad            Int?
  direccion       String?
  fotoPerfil      String?
  resetToken      String?  @unique
  resetTokenExpires DateTime?
  enrollments     Enrollment[]
  reviewedEnrollments Enrollment[] @relation("ReviewedBy")
  taughtClasses   Class[] @relation("TaughtBy")
  attendances     Attendance[]
  evaluations     Evaluation[]
  payments        Payment[]
  costumes        Costume[] @relation("CostumeInstructor")
  choreographies  Choreography[] @relation("ChoreographyInstructor")
  choreographyParticipations ChoreographyParticipant[]
  createdAt       DateTime @default(now())

  @@unique([cedula], name: "User_cedula_key")
}

model Class {
  id          String     @id @default(cuid())
  name        String
  description String?
  instructor  User       @relation("TaughtBy", fields: [instructorId], references: [id])
  instructorId String
  supportMaterial String? // JSON string with URLs for videos, music, documents
  schedules   Schedule[]
  enrollments Enrollment[]
  attendances Attendance[]
  evaluations Evaluation[]
  createdAt   DateTime   @default(now())
}

model Schedule {
  id        String   @id @default(cuid())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  dayOfWeek DayOfWeek
  startTime String   // HH:MM format
  endTime   String   // HH:MM format
  location  String?
  createdAt DateTime @default(now())
}

model Enrollment {
  id             String   @id @default(cuid())
  student        User     @relation(fields: [studentId], references: [id])
  studentId      String
  class          Class    @relation(fields: [classId], references: [id])
  classId        String
  enrollmentDate DateTime @default(now())
  status         EnrollmentStatus @default(PENDING)
  academicLevel  AcademicLevel?
  ageCategory    AgeCategory?
  // Review workflow fields
  reviewNote     String?
  reviewedAt     DateTime?
  reviewer       User?    @relation("ReviewedBy", fields: [reviewerId], references: [id])
  reviewerId     String?
  createdAt      DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(cuid())
  student     User     @relation(fields: [studentId], references: [id])
  studentId   String
  class       Class    @relation(fields: [classId], references: [id])
  classId     String
  date        DateTime @default(now())
  present     Boolean  @default(false)
  note        String?
  observations String? // Detailed observations for the student
  createdAt   DateTime @default(now())
}

model Evaluation {
  id          String   @id @default(cuid())
  student     User     @relation(fields: [studentId], references: [id])
  studentId   String
  class       Class    @relation(fields: [classId], references: [id])
  classId     String
  date        DateTime @default(now())
  score       Float?   // Score out of 10
  comments    String?  // Comments on performance
  progress    String?  // Progress notes
  createdAt   DateTime @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  student         User     @relation(fields: [studentId], references: [id])
  studentId       String
  paymentDate     DateTime @default(now())
  amount          Float
  paymentType     PaymentType
  referenceNumber String?
  bank            String?
  createdAt       DateTime @default(now())
}

model Costume {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String?
  imageUrl    String?
  accessories String?
  estimatedCost Float?
  status      CostumeStatus @default(DESIGN)
  instructor  User         @relation("CostumeInstructor", fields: [instructorId], references: [id])
  instructorId String
  choreography Choreography? @relation(fields: [choreographyId], references: [id])
  choreographyId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Choreography {
  id          String                      @id @default(cuid())
  name        String
  description String?
  level       String?
  music       String?
  videoUrl    String?
  duration    Int?                        // in minutes
  status      ChoreographyStatus          @default(PRACTICE)
  instructor  User                        @relation("ChoreographyInstructor", fields: [instructorId], references: [id])
  instructorId String
  costumes    Costume[]
  participants ChoreographyParticipant[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
}

model ChoreographyParticipant {
  id             String       @id @default(cuid())
  choreography   Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  choreographyId String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  createdAt      DateTime     @default(now())

  @@unique([choreographyId, studentId])
}

enum Role {
  ADMIN
  DIRECTORA_ACADEMICA
  PROFESORA
  ALUMNA
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentType {
  EFECTIVO
  PAGO_MOVIL
  TRANSFERENCIA
}

enum CostumeStatus {
  DESIGN
  APPROVED
  REJECTED
  IN_PRODUCTION
  COMPLETED
}

enum ChoreographyStatus {
  PRACTICE
  DEVELOPMENT
  READY_FOR_PRESENTATION
}

enum AcademicLevel {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum AgeCategory {
  MINI_BELLYDANCE
  BELLYDANCE_ADOLESCENTES
  BELLYDANCE_ADULTAS
}
